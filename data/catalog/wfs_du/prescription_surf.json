{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Prescriptions surfaciques",
  "description": "Prescriptions surfaciques se superposant au zonage, données issues du Géoportail de l'urbanisme",
  "properties": {
    "gid": {
      "type": "integer"
    },
    "gpu_doc_id": {
      "type": "string"
    },
    "gpu_status": {
      "type": "string"
    },
    "gpu_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "partition": {
      "type": "string"
    },
    "libelle": {
      "type": "string"
    },
    "txt": {
      "type": "string"
    },
    "typepsc": {
      "type": "string"
    },
    "nomfic": {
      "type": "string"
    },
    "urlfic": {
      "type": "string"
    },
    "insee": {
      "type": "string"
    },
    "datappro": {
      "type": "string"
    },
    "datvalid": {
      "type": "string"
    },
    "idurba": {
      "type": "string"
    },
    "stypepsc": {
      "type": "string"
    },
    "idpsc": {
      "type": "string"
    },
    "lib_idpsc": {
      "type": "string"
    },
    "the_geom": {
      "format": "geometry-any",
      "x-ogc-role": "primary-geometry"
    },
    "nature": {
      "type": "string"
    },
    "symbole": {
      "type": "string"
    }
  },
  "required": []
}
