{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignfab.github.io/gpf-schema-store/catalog/wfs_du/habillage_lin.json",
  "type": "object",
  "title": "Habillages linéaires",
  "description": "Objet linéaire indicatif porté sur le document d'urbanisme pour l'habillage du plan, données issues du Géoportail de l'urbanisme",
  "properties": {
    "gid": {
      "type": "integer"
    },
    "gpu_doc_id": {
      "type": "string"
    },
    "gpu_status": {
      "type": "string"
    },
    "gpu_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "partition": {
      "type": "string"
    },
    "nattrac": {
      "type": "string"
    },
    "insee": {
      "type": "string"
    },
    "idurba": {
      "type": "string"
    },
    "couleur": {
      "type": "string"
    },
    "idhab": {
      "type": "string"
    },
    "lib_idhab": {
      "type": "string"
    },
    "the_geom": {
      "format": "geometry-any",
      "x-ogc-role": "primary-geometry"
    }
  },
  "required": []
}
