{
  "name": "@ignfab/gpf-schema-store",
  "description": "Experimental OGC API Features schema store enriched from Geoplateforme WFS.",
  "license": "MIT",
  "author": "IGNF",
  "version": "0.3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "node --use-env-proxy ./node_modules/vite-node/dist/cli.mjs src/cli.ts",
    "cli": "node --use-env-proxy dist/cli.js",
    "update:all": "npm run update:datasets && npm run update:csw && npm run update:wfs && npm run update:catalog",
    "update:datasets": "node --use-env-proxy dist/cli.js update-datasets",
    "update:csw": "node --use-env-proxy dist/cli.js update-csw",
    "update:wfs": "node --use-env-proxy dist/cli.js update-wfs",
    "csw:dump": "node --use-env-proxy dist/cli.js csw-dump",
    "update:catalog": "node --use-env-proxy dist/cli.js render-catalog data/catalog --clean",
    "check:overwrites": "node --use-env-proxy dist/cli.js check-overwrites",
    "start": "npm run cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "vitest run --config vitest.config.all.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "@camptocamp/ogc-client": "^1.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.0.0",
    "js-yaml": "^5.5.0",
    "minisearch": "^7.2.0",
    "xpath": "0.0.35",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
